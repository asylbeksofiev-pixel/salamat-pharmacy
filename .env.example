# Copy to .env and fill in. Never commit real secrets.

# PostgreSQL (local: scripts/db-local.sh start  or  docker compose up -d db)
DATABASE_URL="postgresql://salamat@127.0.0.1:5433/salamat"
# Optional: separate databases for tests (names must contain "test"; they are reset by the test runner)
# TEST_DATABASE_URL="postgresql://salamat@127.0.0.1:5433/salamat_test"
# E2E_DATABASE_URL="postgresql://salamat@127.0.0.1:5433/salamat_e2e_test"

# Public site URL (canonical links, sitemap, e-mail links)
APP_URL="http://localhost:3000"
# Random secret (>= 32 chars) for hashing client IPs in rate limits. Required in production.
APP_SECRET=""
# Allow search engines to index the site (keep false on staging)
ALLOW_INDEXING=false
# Show demo products loaded by `npm run db:demo` (development only; never in production)
SHOW_DEMO_DATA=false

# First Super Admin, created by `npm run db:seed` if set (or use `npm run admin:create`)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Администратор"

# E-mail notifications to operators about new requests (optional; requests are always stored in the DB)
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
OPERATOR_EMAILS=""

# Authorised catalogue API of SALAMAT's accounting system (optional, see docs/data-import.md)
CATALOG_API_URL=""
CATALOG_API_TOKEN=""
CATALOG_API_NAME=""

# Hosts allowed for optimised product images, comma-separated (e.g. cdn.salamat.kz)
IMAGE_HOSTS=""

# Product photo pipeline (npm run photos, docs/catalog-photos.md). Runs on a workstation/CI, never on page requests.
# Vercel Blob token — only `publish` needs it (Vercel → Storage → Blob). Never commit it.
BLOB_READ_WRITE_TOKEN=""
# Folder with photos supplied by SALAMAT or manufacturers + photos.csv (product_id/barcode, file, source_name, permission)
PHOTOS_INBOX_DIR=""
# Written permission to reuse NCT (nct.gov.kz) photos, e.g. "Письмо № … от …". Empty = NCT photos are never downloaded.
NCT_IMAGE_PERMISSION=""
# Pause between requests to nct.gov.kz in ms for `npm run photos:nct` (minimum and default 1000)
NCT_INTERVAL_MS=""
# Contact shown in the pipeline's User-Agent (defaults to APP_URL)
PHOTO_BOT_CONTACT=""

# Secret for the daily retention cron (Vercel Cron sends it as a Bearer token)
CRON_SECRET=""

# Cookies with the Secure flag (defaults to true in production)
# COOKIE_SECURE=true
