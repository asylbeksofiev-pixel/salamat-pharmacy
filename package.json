{
  "name": "salamat-pharmacy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --trace off",
    "db:local": "scripts/db-local.sh start",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:demo": "tsx --conditions=react-server scripts/seed-demo.ts",
    "admin:create": "tsx --conditions=react-server scripts/create-admin.ts",
    "import:file": "tsx --conditions=react-server scripts/import-file.ts",
    "orders:anonymize": "tsx --conditions=react-server scripts/anonymize-orders.ts",
    "templates:build": "tsx scripts/make-templates.ts",
    "postinstall": "prisma generate",
    "db:catalog-fixture": "node scripts/catalog-fixture.mjs",
    "catalog:classify": "tsx scripts/classify-catalog.ts"
  },
  "dependencies": {
    "@fontsource-variable/onest": "^5.3.1",
    "@prisma/client": "^6.19.3",
    "exceljs": "^4.4.0",
    "leaflet": "1.9.4",
    "next": "16.4.6",
    "nodemailer": "^10.5.0",
    "papaparse": "^5.7.1",
    "prisma": "^6.19.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/leaflet": "1.9.22",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20.9"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
